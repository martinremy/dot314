{
  "name": "pi-poly-notify",
  "version": "0.1.4",
  "description": "Highly configurable desktop/sound/Pushover notifications when a long Pi agent run finishes or waits on a dialog, with an optional mode that waits until all parallel Pi sessions have stopped",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w-winter/dot314.git",
    "directory": "packages/pi-poly-notify"
  },
  "bugs": {
    "url": "https://github.com/w-winter/dot314/issues"
  },
  "homepage": "https://github.com/w-winter/dot314#readme",
  "pi": {
    "extensions": [
      "extensions/poly-notify/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "prepack": "node ../../scripts/pi-package-prepack.mjs"
  },
  "files": [
    "extensions/poly-notify/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dot314Prepack": {
    "copy": [
      {
        "from": "../../extensions/poly-notify/index.ts",
        "to": "extensions/poly-notify/index.ts"
      },
      {
        "from": "../../extensions/poly-notify/working-sessions.ts",
        "to": "extensions/poly-notify/working-sessions.ts"
      },
      {
        "from": "../../extensions/poly-notify/notify.json.example",
        "to": "extensions/poly-notify/notify.json.example"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ]
  }
}
